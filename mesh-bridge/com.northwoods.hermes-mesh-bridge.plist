<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.northwoods.hermes-mesh-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/Library/Application Support/hermes-mesh-bridge/hermes-mesh-bridge.py</string>
  </array>
  <key>WatchPaths</key>
  <array><string>__HOME__/.claude/mesh/inbox/hermes</string></array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/hermes-mesh-bridge.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/hermes-mesh-bridge.log</string>
</dict>
</plist>
