<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Minutes</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>Minutes</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Minutes listens to the room so it can type out what people say. Audio is never saved.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Minutes listens to call audio playing on this Mac so it can type out what callers say. Audio is never saved.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Minutes turns speech into text on this Mac.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Minutes saves meeting transcripts into your Meeting Transcripts folder in Notes and reads your notes so Claude can search them.</string>
</dict>
</plist>
